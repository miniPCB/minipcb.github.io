{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "miniPCB shared resistor catalog",
  "description": "Family document by default. The manifest uses #/$defs/manifest. Runtime checks also validate cross-field constraints and sourced examples.",
  "$ref": "#/$defs/family",
  "$defs": {
    "family": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "minLength": 1
        },
        "schemaVersion": {
          "const": 1
        },
        "revision": {
          "type": "string",
          "format": "date"
        },
        "manufacturer": {
          "type": "string",
          "minLength": 1
        },
        "component": {
          "const": "resistor"
        },
        "stock": {
          "type": "object",
          "properties": {
            "status": {
              "const": "unknown"
            },
            "checkedAt": {
              "type": "null"
            }
          },
          "required": [
            "status",
            "checkedAt"
          ],
          "additionalProperties": false
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "encoding": {
          "enum": [
            "mil55342",
            "rkm4"
          ]
        },
        "prefix": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "defaults": {
          "type": "object",
          "properties": {
            "package": {
              "type": "string",
              "minLength": 1
            },
            "tolerancePct": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "tcrCode": {
              "type": "string",
              "minLength": 1
            },
            "packaging": {
              "type": "string",
              "minLength": 1
            },
            "failureRate": {
              "type": "string",
              "minLength": 1
            },
            "mode": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "package",
            "tolerancePct",
            "tcrCode",
            "packaging",
            "mode"
          ],
          "additionalProperties": false
        },
        "tcrCodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "ppm": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "code",
              "ppm"
            ],
            "additionalProperties": false
          }
        },
        "toleranceCodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "pct": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "letters": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "series": {
                "type": "string",
                "minLength": 1
              },
              "additionalSeries": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "pct"
            ],
            "additionalProperties": false
          }
        },
        "packaging": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "tcrCodes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "code",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "terminationCodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "code",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "failureRates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "percentPer1000h": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "code",
              "percentPer1000h",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "suffixRules": {
          "type": "object",
          "properties": {
            "requiredThinFilmCodes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "minimumTolerancePct": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "thinFilmSuffix": {
              "type": "string",
              "minLength": 1
            },
            "markingSuffix": {
              "type": "string",
              "minLength": 1
            },
            "markingExcludedPackages": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "requiredThinFilmCodes",
            "minimumTolerancePct",
            "thinFilmSuffix",
            "markingSuffix",
            "markingExcludedPackages"
          ],
          "additionalProperties": false
        },
        "powerModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "ratedAtC": {
                "type": "number"
              },
              "zeroAtC": {
                "type": "number"
              },
              "minimumAmbientC": {
                "type": "number"
              },
              "maximumAmbientC": {
                "type": "number"
              },
              "condition": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "label",
              "ratedAtC",
              "zeroAtC",
              "minimumAmbientC",
              "maximumAmbientC",
              "condition"
            ],
            "additionalProperties": false
          }
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/package"
          }
        },
        "verifiedParts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "mpn": {
                "type": "string",
                "minLength": 1
              },
              "sourceId": {
                "type": "string",
                "minLength": 1
              },
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "kind": {
                "enum": [
                  "historical-example",
                  "ordering-example",
                  "catalog-entry"
                ]
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "mpn",
              "sourceId",
              "page",
              "kind",
              "note"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "revision",
        "manufacturer",
        "component",
        "stock",
        "id",
        "name",
        "encoding",
        "sources",
        "scope",
        "defaults",
        "tcrCodes",
        "toleranceCodes",
        "packaging",
        "powerModes",
        "packages",
        "verifiedParts"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "encoding": {
                "const": "mil55342"
              }
            }
          },
          "then": {
            "required": [
              "terminationCodes",
              "failureRates",
              "suffixRules"
            ],
            "properties": {
              "defaults": {
                "required": [
                  "failureRate"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "encoding": {
                "const": "rkm4"
              }
            }
          },
          "then": {
            "required": [
              "prefix"
            ]
          }
        }
      ]
    },
    "manifest": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "minLength": 1
        },
        "schemaVersion": {
          "const": 1
        },
        "revision": {
          "type": "string",
          "format": "date"
        },
        "seriesSource": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1
            },
            "pages": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "verifiedOn": {
              "type": "string",
              "format": "date"
            }
          },
          "required": [
            "url",
            "pages",
            "verifiedOn"
          ],
          "additionalProperties": false
        },
        "series": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^E[0-9]+$"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 100,
              "maximum": 999
            }
          }
        },
        "families": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "file": {
                "type": "string",
                "pattern": "^resistors/[a-z0-9-]+\\.json$"
              }
            },
            "required": [
              "id",
              "file"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "revision",
        "seriesSource",
        "series",
        "families"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "revision": {
          "type": "string",
          "format": "date"
        },
        "verifiedOn": {
          "type": "string",
          "format": "date"
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "category": {
          "enum": [
            "datasheet",
            "specification",
            "catalog"
          ]
        },
        "organization": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "title",
        "url",
        "verifiedOn"
      ],
      "additionalProperties": false
    },
    "limit": {
      "type": "object",
      "properties": {
        "tcrCodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tolerancesPct": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "minOhms": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxOhms": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "series": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "tcrCodes",
        "tolerancesPct",
        "minOhms",
        "maxOhms"
      ],
      "additionalProperties": false
    },
    "package": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "case": {
          "type": "string",
          "minLength": 1
        },
        "style": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "powerW": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "workingVoltageV": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "packagingCodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/limit"
          }
        }
      },
      "required": [
        "code",
        "case",
        "model",
        "powerW",
        "workingVoltageV",
        "packagingCodes",
        "limits"
      ],
      "additionalProperties": false
    }
  }
}
